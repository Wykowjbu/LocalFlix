// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. NGƯỜI DÙNG & HỒ SƠ (NETFLIX PROFILES)
// ==========================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles  Profile[]
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  avatarUrl String?
  userId    String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  favorites Favorite[]
  history   WatchHistory[]

  @@index([userId])
}

// ==========================================
// 2. DỮ LIỆU PHIM & ĐỒNG BỘ (SYNC DATA)
// ==========================================

model Movie {
  id               String  @id @default(cuid())

  // Định danh từ API nguồn
  sourceId         String? @unique
  slug             String  @unique

  // Thông tin hiển thị
  name             String
  originalName     String?
  thumbUrl         String?
  posterUrl        String?
  description      String?

  // Chi tiết phim
  totalEpisodes    Int?
  currentEpisode   String?
  time             String?
  quality          String?
  language         String?
  director         String?
  casts            String?

  // Tracking thời gian để phục vụ Sync Logic
  sourceCreatedAt  DateTime?
  sourceModifiedAt DateTime?
  lastSyncedAt     DateTime?

  // Thời gian DB nội bộ
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Quan hệ
  episodes         Episode[]
  tags             MovieTag[]
  collections      MovieCollection[]
  favorites        Favorite[]
  history          WatchHistory[]

  // Đánh index cực kỳ quan trọng để search và filter nhanh
  @@index([slug])
  @@index([name])
  @@index([originalName])
  @@index([sourceModifiedAt]) // Index này giúp query ra những phim nào có update mới nhất nhanh hơn
}

model Episode {
  id         String   @id @default(cuid())
  movieSlug  String

  serverName String
  name       String
  slug       String

  embedUrl   String?
  m3u8Url    String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  movie      Movie    @relation(fields: [movieSlug], references: [slug], onDelete: Cascade)

  // Cặp khóa duy nhất để phục vụ hàm upsert (Cập nhật nếu có, tạo mới nếu chưa)
  @@unique([movieSlug, serverName, slug])
  @@index([movieSlug])
}

// ==========================================
// 3. HỆ THỐNG PHÂN LOẠI ĐỘNG (TAGS & GROUPS)
// ==========================================

model TagGroup {
  id   String @id @default(cuid())
  name String @unique // Ví dụ: "Năm", "Quốc gia", "Thể loại", "Định dạng"

  tags Tag[]
}

model Tag {
  id      String @id @default(cuid())
  name    String // Ví dụ: "2024", "Trung Quốc", "Hành Động"
  slug    String
  groupId String

  group   TagGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  movies  MovieTag[]

  @@unique([groupId, slug]) // Trong cùng 1 nhóm không được trùng slug
  @@index([groupId])
}

model MovieTag {
  movieSlug String
  tagId     String

  movie     Movie @relation(fields: [movieSlug], references: [slug], onDelete: Cascade)
  tag       Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([movieSlug, tagId])
}

// ==========================================
// 4. DANH SÁCH HIỂN THỊ TRANG CHỦ (COLLECTIONS)
// ==========================================

model Collection {
  id           String    @id @default(cuid())
  name         String    // Ví dụ: "Phim đang chiếu"
  title        String?   
  slug         String    @unique // Ví dụ: "phim-dang-chieu"
  type         String?   // Ví dụ: "danh-sach", "the-loai", "latest"
  endpoint     String?   // Lưu lại URL gốc để dễ gọi API sync
  
  lastSyncedAt DateTime?

  movies       MovieCollection[]
}

model MovieCollection {
  collectionId String
  movieSlug    String
  position     Int?      // Để sort thứ tự phim hiển thị trên UI (như Top 10)
  page         Int?      // Lưu lại phim này nằm ở page mấy của API (tiện cho việc debug sync)

  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  movie        Movie      @relation(fields: [movieSlug], references: [slug], onDelete: Cascade)

  @@id([collectionId, movieSlug])
  @@index([movieSlug])
}

// ==========================================
// 5. TƯƠNG TÁC NGƯỜI DÙNG
// ==========================================

model Favorite {
  id        String   @id @default(cuid())
  profileId String
  movieSlug String
  createdAt DateTime @default(now())

  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieSlug], references: [slug], onDelete: Cascade)

  @@unique([profileId, movieSlug])
  @@index([profileId])
  @@index([movieSlug])
}

model WatchHistory {
  id          String   @id @default(cuid())
  profileId   String
  movieSlug   String

  episodeSlug String?  // Lưu slug tập đang xem
  serverName  String?  // Ghi nhớ user đang xem server nào
  progress    Int?     // Đã xem tới giây thứ bao nhiêu
  duration    Int?     // Tổng thời lượng video (để tính % tiến trình)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt // Cực kỳ quan trọng để lôi phim vừa xem xong lên đầu danh sách "Tiếp tục xem"

  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movie       Movie    @relation(fields: [movieSlug], references: [slug], onDelete: Cascade)

  @@unique([profileId, movieSlug])
  @@index([profileId])
  @@index([movieSlug])
}