// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL") // Prisma 6 hỗ trợ khai báo url trực tiếp tại đây
}

// ------------------------------------------------------
// QUẢN LÝ NGƯỜI DÙNG & HỒ SƠ (NETFLIX PROFILE)
// ------------------------------------------------------

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String    // Password đã được hash
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  profiles  Profile[]
}

model Profile {
  id        String    @id @default(cuid())
  name      String    // Ví dụ: "Huy", "Kids", ...
  avatarUrl String?   
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  favorites Favorite[] 
  history   WatchHistory[]
}

// ------------------------------------------------------
// QUẢN LÝ DỮ LIỆU PHIM (Đã tối ưu cho việc Sync Data)
// ------------------------------------------------------

model Movie {
  id              String    @id @default(cuid())
  slug            String    @unique 
  name            String
  originalName    String?
  thumbUrl        String?
  posterUrl       String?
  description     String?   
  totalEpisodes   Int?
  currentEpisode  String?
  time            String?
  quality         String?
  language        String?
  director        String?
  casts           String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Quan hệ 1-N (1 Phim có nhiều Tập)
  episodes        Episode[]
  
  // Quan hệ N-N (Nhiều phim thuộc nhiều Thể loại / Quốc gia)
  categories      Category[] 
  countries       Country[]  

  // Tương tác của người dùng
  favorites       Favorite[]
  history         WatchHistory[]
}

model Episode {
  id          String   @id @default(cuid())
  serverName  String   // Ví dụ: "Vietsub #1"
  name        String   // Ví dụ: "1", "2"
  slug        String   
  embedUrl    String?  
  m3u8Url     String?  
  
  movieId     String
  movie       Movie    @relation(fields: [movieId], references: [slug], onDelete: Cascade) 

  @@unique([movieId, serverName, slug]) // Tránh lưu trùng 1 tập của 1 server
}

// ------------------------------------------------------
// BẢNG BỔ TRỢ (LỌC THEO THỂ LOẠI & QUỐC GIA)
// ------------------------------------------------------

model Category {
  id     String  @id @default(cuid())
  name   String  // Ví dụ: "Hành Động"
  slug   String  @unique // Ví dụ: "hanh-dong"
  
  movies Movie[]
}

model Country {
  id     String  @id @default(cuid())
  name   String  // Ví dụ: "Âu Mỹ"
  slug   String  @unique // Ví dụ: "au-my"
  
  movies Movie[]
}

// ------------------------------------------------------
// TƯƠNG TÁC CỦA NGƯỜI DÙNG (MY LIST & LỊCH SỬ)
// ------------------------------------------------------

model Favorite {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [slug], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  @@unique([profileId, movieId]) 
}

model WatchHistory {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movieId   String
  movie     Movie    @relation(fields: [movieId], references: [slug], onDelete: Cascade)
  
  episodeSlug String?  // Lưu lại tập đang xem dở
  progress    Int?     // Lưu số giây đang xem
  updatedAt   DateTime @updatedAt 

  @@unique([profileId, movieId]) 
}