generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles Profile[]
}

model Profile {
  id        String  @id @default(cuid())
  name      String
  avatarUrl String?
  userId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  favorites Favorite[]
  history   WatchHistory[]
  reactions Reaction[]

  @@index([userId])
}

model Movie {
  id String @id @default(cuid())

  sourceId String? @unique
  slug     String  @unique

  name         String
  originalName String?
  thumbUrl     String?
  posterUrl    String?
  description  String?

  totalEpisodes  Int?
  currentEpisode String?
  time           String?
  quality        String?
  language       String?
  director       String?
  casts          String?

  sourceCreatedAt  DateTime?
  sourceModifiedAt DateTime?
  lastSyncedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  episodes    Episode[]
  tags        MovieTag[]
  collections MovieCollection[]
  favorites   Favorite[]
  history     WatchHistory[]
  reactions   Reaction[]
  netflixTop10 NetflixTop10[]

  @@index([slug])
  @@index([name])
  @@index([originalName])
  @@index([sourceModifiedAt])
}

model Episode {
  id        String @id @default(cuid())
  movieSlug String

  serverName String
  name       String
  slug       String

  embedUrl String?
  m3u8Url  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movie Movie @relation(fields: [movieSlug], references: [slug], onDelete: Cascade)

  @@unique([movieSlug, serverName, slug])
  @@index([movieSlug])
}

model TagGroup {
  id   String @id @default(cuid())
  name String @unique

  tags Tag[]
}

model Tag {
  id      String @id @default(cuid())
  name    String
  slug    String
  groupId String

  group  TagGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  movies MovieTag[]

  @@unique([groupId, slug])
  @@index([groupId])
}

model MovieTag {
  movieSlug String
  tagId     String

  movie Movie @relation(fields: [movieSlug], references: [slug], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([movieSlug, tagId])
}

model Collection {
  id       String  @id @default(cuid())
  name     String
  title    String?
  slug     String  @unique
  type     String?
  endpoint String?

  lastSyncedAt DateTime?

  movies MovieCollection[]
}

model MovieCollection {
  collectionId String
  movieSlug    String
  position     Int?
  page         Int?

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  movie      Movie      @relation(fields: [movieSlug], references: [slug], onDelete: Cascade)

  @@id([collectionId, movieSlug])
  @@index([movieSlug])
}

model Favorite {
  id        String   @id @default(cuid())
  profileId String
  movieSlug String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movie   Movie   @relation(fields: [movieSlug], references: [slug], onDelete: Cascade)

  @@unique([profileId, movieSlug])
  @@index([profileId])
  @@index([movieSlug])
}

model Reaction {
  id        String   @id @default(cuid())
  profileId String
  movieSlug String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movie   Movie   @relation(fields: [movieSlug], references: [slug], onDelete: Cascade)

  @@unique([profileId, movieSlug])
  @@index([profileId])
  @@index([movieSlug])
}

model WatchHistory {
  id        String @id @default(cuid())
  profileId String
  movieSlug String

  episodeSlug String?
  serverName  String?
  progress    Int?
  duration    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movie   Movie   @relation(fields: [movieSlug], references: [slug], onDelete: Cascade)

  @@unique([profileId, movieSlug])
  @@index([profileId])
  @@index([movieSlug])
}

model NetflixTop10 {
  id              String   @id @default(cuid())
  country         String   @default("vietnam")
  type            String
  weekLabel       String
  rank            Int

  netflixTitle    String
  normalizedTitle String
  imageUrl        String?
  netflixUrl      String?
  netflixId       String?

  matchedMovieSlug String?
  matchStatus      String  @default("pending")
  matchScore       Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchedMovie Movie? @relation(fields: [matchedMovieSlug], references: [slug])

  @@unique([country, type, weekLabel, rank])
  @@index([country, type, weekLabel])
  @@index([matchedMovieSlug])
}
